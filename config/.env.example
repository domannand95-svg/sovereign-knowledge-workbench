SKW_MODEL_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
SKW_MODEL_NAME=qwen2.5-coder:7b
SKW_MODEL_TIMEOUT=120
# Fail-closed external command that accepts a proposal JSON object on stdin.
# It must return sovereign.authorization.receipt.v3 bound to the exact proposal,
# requester, capability request, nonce, and bounded lifetime.
# The Workbench independently verifies the receipt; self-verification is not trusted.
# SKW_SOVEREIGN_AUTHORIZER=cargo run -p sovereign-agent-runtime --bin sovereign-authorize --
SKW_SOVEREIGN_VERIFYING_KEY=replace-with-pinned-ed25519-public-key-hex
SKW_REQUESTER_ID=replace-with-derived-sovereign-requester-identity
SKW_GRANT_LEDGER=workbench-output/grants.db
# Python interpreter containing the installed BKI dependencies.
# SKW_PYTHON=C:\path\to\bki\.venv\Scripts\python.exe
